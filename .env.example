# LLM Provider Configuration
# Choose your provider: "openrouter", "openai", "gemini", "deepseek", or "mock"
LLM_PROVIDER=openrouter

# OpenRouter (Recommended for Nous Hermes 3: nousresearch/hermes-3-llama-3.1-405b or 8b)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# DeepSeek (if using deepseek-flash or deepseek-v4-pro)
DEEPSEEK_API_KEY=your_deepseek_api_key_here
# LLM_MODEL=deepseek-flash

# OpenAI (if using gpt-4o-mini or whisper-1)
OPENAI_API_KEY=your_openai_api_key_here

# Groq (if using ultra-fast Groq Whisper for audio transcription: whisper-large-v3)
GROQ_API_KEY=your_groq_api_key_here

# Gemini (if using Gemini 2.0 Flash)
GEMINI_API_KEY=your_gemini_api_key_here

# Google Custom Search API (for Vendor Reprint Discovery)
GOOGLE_SEARCH_API_KEY=your_google_search_api_key_here
GOOGLE_SEARCH_ENGINE_ID=your_google_search_cx_here

# MCP Server Settings
MCP_TRANSPORT=stdio
MCP_PORT=8080
MCP_HOST=0.0.0.0
