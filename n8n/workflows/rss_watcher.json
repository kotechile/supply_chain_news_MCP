{
  "name": "Supply Chain Intel - RSS Watcher",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 6
            }
          ]
        }
      },
      "id": "1",
      "name": "Every 6 Hours",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [250, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://public-news-mcp:8080/api/crawl/newsrooms?max=10",
        "options": {}
      },
      "id": "2",
      "name": "Crawl Newsrooms",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [480, 200]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://public-news-mcp:8080/api/crawl/podcasts?max=5",
        "options": {}
      },
      "id": "3",
      "name": "Watch Podcasts",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [480, 400]
    }
  ],
  "connections": {
    "Every 6 Hours": {
      "main": [
        [
          {
            "node": "Crawl Newsrooms",
            "type": "main",
            "index": 0
          },
          {
            "node": "Watch Podcasts",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
