{
  "name": "Supply Chain Intel - Daily Executive Briefing",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "daysInterval": 1,
              "triggerAtHour": 8,
              "triggerAtMinute": 0
            }
          ]
        }
      },
      "id": "1",
      "name": "Daily at 8:00 AM",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [250, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "http://public-news-mcp:8080/api/insights/recent?days_back=1&limit=5",
        "options": {}
      },
      "id": "2",
      "name": "Fetch Last 24h Intelligence",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [480, 300]
    },
    {
      "parameters": {
        "chatId": "YOUR_TELEGRAM_CHAT_ID",
        "text": "=📊 **Daily Supply Chain Advisory Briefing** ({{ $json.count }} new items)\n\n{{ $json.items.map(i => `• *[${i.source_name}]* ${i.title}\n  ${i.summary}\n  🔗 ${i.url}`).join('\\n\\n') }}",
        "additionalFields": {
          "parse_mode": "Markdown"
        }
      },
      "id": "3",
      "name": "Telegram Alert (Optional)",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [720, 300]
    }
  ],
  "connections": {
    "Daily at 8:00 AM": {
      "main": [
        [
          {
            "node": "Fetch Last 24h Intelligence",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Last 24h Intelligence": {
      "main": [
        [
          {
            "node": "Telegram Alert (Optional)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
